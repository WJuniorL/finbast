# Copie para .env.local e preencha com as credenciais do projeto Supabase do Finbast
# (Project Settings → API, no dashboard do Supabase). Nunca commitar o .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — sem prefixo NEXT_PUBLIC_. Só para código de servidor que precise
# ignorar RLS (operações administrativas). Ainda não usada em nenhum lugar do código.
SUPABASE_SECRET_KEY=
