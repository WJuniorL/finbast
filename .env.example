# Copie para .env.local e preencha com as credenciais do projeto Supabase do Finbast
# (Project Settings → API, no dashboard do Supabase). Nunca commitar o .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — sem prefixo NEXT_PUBLIC_. Só para código de servidor que precise
# ignorar RLS (operações administrativas). Ainda não usada em nenhum lugar do código.
SUPABASE_SECRET_KEY=

# Somente scripts locais de migration/teste. Copie a URL Postgres do projeto Finbast.
# Use URL com senha percent-encoded; nunca publique ou registre esse valor em logs.
SUPABASE_DB_URL=
OPENAI_API_KEY=